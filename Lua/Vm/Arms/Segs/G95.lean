  have hrd3 : σ3.regs.get? Register.x1 = some (0x8001fc8c#64 : BitVec 64) := by
    have := obs_jal_rd hobs3 (by decide) (by decide) (by decide) (by decide) (by decide)
    rwa [show BitVec.addInt (0x8001fc88#64) 4 = (0x8001fc8c#64 : BitVec 64) from by decide] at this
  have hp3 : PinsHold σ3 [⟨Register.x1, (0x8001fc8c#64 : BitVec 64)⟩, ⟨Register.x10, ((sign_extend (m := 64) (bytesT8 (m0) (v15 + sign_extend (m := 64) (0x000#12)).toNat : BitVec (8 * 8))) + sign_extend (m := 64) (0x000#12))⟩, ⟨Register.x26, (sign_extend (m := 64) (bytesT8 (m0) (v15 + sign_extend (m := 64) (0x000#12)).toNat : BitVec (8 * 8)))⟩, ⟨Register.x15, v15⟩] :=
    ⟨hrd3, pins_jal hobs3 (by rfl) hp2⟩
  obtain ⟨vmi3, hmi3⟩ := obs_jal_minstret hobs3
  have hmemE3 : σ3.mem = m0 := by
    rw [hmem3]; exact hmemE2
  have hload3 : Lua.Vm.Arms.TextLoaded σ3.mem := by
    rw [hmem3]; exact hload2
  have hsteps3 : Steps c ⟨σ3, i3, c.steps + 1 + 1 + 1⟩ :=
    ((Steps.single hs1).trans (Steps.single hs2)).trans (Steps.single hs3)
  exact ⟨⟨σ3, i3, c.steps + 1 + 1 + 1⟩, hsteps3,
    ⟨hG3, hpc3, hp3, ⟨vmi3, hmi3⟩, hi3, ⟨hload3, hmemE3⟩⟩⟩

end Lua.Vm.Arms
