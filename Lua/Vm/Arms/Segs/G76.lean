  exact ⟨⟨σ1, i1, c.steps + 1⟩, hsteps1,
    ⟨hG1, hpc1, hp1, ⟨vmi1, hmi1⟩, hi1, ⟨hload1, hmemE1, hout1, hok1⟩⟩⟩

end Lua.Vm.Arms
