    ((Steps.single hs1).trans (Steps.single hs2)).trans (Steps.single hs3)
  exact ⟨⟨σ3, i3, c.steps + 1 + 1 + 1⟩, hsteps3,
    ⟨hG3, hpc3, hp3, ⟨vmi3, hmi3⟩, hi3, ⟨hload3, hmemE3, hout3, hok3⟩⟩⟩

end Lua.Vm.Arms
