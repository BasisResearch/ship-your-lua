  -- === step 2: 0x8001fabc `site_8001fabc` (jal) ===
  obtain ⟨σ2, i2, hs2, hi2, hG2, hmem2, hobs2⟩ :=
    site_8001fabc σ1 i1 (c.steps + 1) (0x8001fabc#64)
